@startuml
autonumber
actor User
participant "Web UI" as UI
participant "Auth Controller" as Controller
participant "Auth Service" as Service
participant "Auth Repository" as Repo
database "Database" as DB
participant "Notification Service" as Notify

User -> UI: Request password reset with email
UI -> Controller: POST /auth/forgot-password
Controller -> Service: requestPasswordReset(email)
Service -> Repo: findUserByEmail(email)
Repo -> DB: SELECT user by email
DB --> Repo: User / no row
Repo --> Service: User / null

alt Email not found
  Service --> Controller: 404 Email not registered
  Controller --> UI: Error response
  UI --> User: Show email not found
else Email found
  Service -> Service: Generate reset token
  Service -> Repo: saveResetToken(userId, token, expiry)
  Repo -> DB: UPDATE user reset fields
  DB --> Repo: Token saved
  Repo --> Service: Persisted
  Service -> Notify: sendPasswordResetLink(email, token)
  Notify --> Service: Notification accepted
  Service --> Controller: 200 Reset email sent
  Controller --> UI: Success response
  UI --> User: Prompt user to check email

  User -> UI: Submit new password from reset link
  UI -> Controller: POST /auth/reset-password
  Controller -> Service: resetPassword(token, newPassword)
  Service -> Repo: validateResetToken(token)
  Repo -> DB: SELECT user by reset token + expiry
  DB --> Repo: Token valid?/invalid
  Repo --> Service: User / null

  alt Invalid/expired token
    Service --> Controller: 400 Invalid or expired token
    Controller --> UI: Error response
    UI --> User: Ask to request new link
  else Valid token
    Service -> Service: Hash new password
    Service -> Repo: updatePasswordAndClearToken(userId, hash)
    Repo -> DB: UPDATE password + clear reset token
    DB --> Repo: Password updated
    Repo --> Service: Persisted
    Service --> Controller: 200 Password reset successful
    Controller --> UI: Success response
    UI --> User: Redirect to login
  end
end
@enduml