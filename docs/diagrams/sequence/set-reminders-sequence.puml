@startuml
autonumber
actor User
participant "Web UI" as UI
participant "Reminder Controller" as Controller
participant "Reminder Service" as Service
participant "Reminder Repository" as Repo
database "Database" as DB
participant "Notification Service" as Notify

User -> UI: Configure reminder(s) for an appointment
UI -> Controller: POST /appointments/{id}/reminders
Controller -> Service: setReminders(appointmentId, reminders)
Service -> Service: Validate reminder times (< start time)

alt Invalid reminder time
  Service --> Controller: 400 Invalid reminder
  Controller --> UI: Error response
  UI --> User: Show invalid reminder message
else Valid reminder(s)
  Service -> Repo: saveReminders(appointmentId, reminders)
  Repo -> DB: INSERT reminder records
  DB --> Repo: Reminders saved
  Repo --> Service: Persisted
  Service -> Notify: scheduleReminderNotifications(reminders)
  Notify --> Service: Notifications scheduled
  Service --> Controller: 201 Reminders configured
  Controller --> UI: Success response
  UI --> User: Show reminder summary
end
@enduml