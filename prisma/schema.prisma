generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AppointmentSourceKind {
  USER
  SYSTEM
}

enum ReminderState {
  PENDING
  TRIGGERED
  SNOOZED
  CANCELLED
}

enum ReminderEventType {
  TRIGGERED
  SNOOZED
  CANCELLED
}

enum NotificationType {
  REMINDER
  SYSTEM
}

enum AuthAttemptResult {
  SUCCESS
  FAILURE
}

model User {
  id            String              @id @default(uuid()) @db.Uuid
  email         String              @unique @db.VarChar(255)
  passwordHash  String              @map("password_hash") @db.VarChar(255)
  displayName   String?             @map("display_name") @db.VarChar(100)
  avatarUrl     String?             @map("avatar_url") @db.VarChar(1024)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(6)
  series        AppointmentSeries[]
  appointments  Appointment[]
  tags          Tag[]
  reminders     Reminder[]
  notifications Notification[]
  authAttempts  AuthAttempt[]
  monthlyStats  UserMonthlyStat[]

  @@map("users")
}

model AppointmentSeries {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  title               String               @db.VarChar(255)
  description         String?
  recurrenceFreq      RecurrenceFrequency  @map("recurrence_freq")
  recurrenceInterval  Int                  @default(1) @map("recurrence_interval")
  recurrenceByDay     String[]             @default([]) @map("recurrence_by_day") @db.VarChar(32)
  recurrenceDayOfMonth Int?                @map("recurrence_day_of_month") @db.SmallInt
  recurrenceCount     Int?                 @map("recurrence_count")
  recurrenceUntil     DateTime?            @map("recurrence_until") @db.Timestamptz(6)
  seriesTimezone      String               @map("series_timezone") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments        Appointment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, cancelledAt])
  @@map("appointment_series")
}

model Appointment {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  seriesId            String?               @map("series_id") @db.Uuid
  title               String                @db.VarChar(255)
  description         String?
  startsAt            DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime              @map("ends_at") @db.Timestamptz(6)
  status              AppointmentStatus
  isAllDay            Boolean               @default(false) @map("is_all_day")
  isRecurringInstance Boolean               @default(false) @map("is_recurring_instance")
  occurrenceIndex     Int?                  @map("occurrence_index")
  sourceKind          AppointmentSourceKind @default(USER) @map("source_kind")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?             @map("deleted_at") @db.Timestamptz(6)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  series              AppointmentSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  reminders           Reminder[]
  notifications       Notification[]
  tags                AppointmentTag[]

  @@index([userId, startsAt])
  @@index([userId, status, startsAt])
  @@index([seriesId, occurrenceIndex])
  @@map("appointments")
}

model Tag {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  name       String           @db.VarChar(50)
  color      String?          @db.VarChar(16)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taggedWith AppointmentTag[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("tags")
}

model AppointmentTag {
  appointmentId String      @map("appointment_id") @db.Uuid
  tagId         String      @map("tag_id") @db.Uuid
  assignedAt    DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([appointmentId, tagId])
  @@index([tagId, appointmentId])
  @@map("appointment_tags")
}

model Reminder {
  id                String          @id @default(uuid()) @db.Uuid
  appointmentId     String          @map("appointment_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  remindAt          DateTime        @map("remind_at") @db.Timestamptz(6)
  nextTriggerAt     DateTime        @map("next_trigger_at") @db.Timestamptz(6)
  state             ReminderState
  triggeredAt       DateTime?       @map("triggered_at") @db.Timestamptz(6)
  snoozeCount       Int             @default(0) @map("snooze_count")
  lastSnoozeMinutes Int?            @map("last_snooze_minutes")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointment       Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            ReminderEvent[]
  notifications     Notification[]

  @@index([appointmentId])
  @@index([userId, state, nextTriggerAt])
  @@map("reminders")
}

model ReminderEvent {
  id         String            @id @default(uuid()) @db.Uuid
  reminderId String            @map("reminder_id") @db.Uuid
  eventType  ReminderEventType @map("event_type")
  eventAt    DateTime          @default(now()) @map("event_at") @db.Timestamptz(6)
  payload    Json?
  reminder   Reminder          @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId, eventAt(sort: Desc)])
  @@map("reminder_events")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  appointmentId String?         @map("appointment_id") @db.Uuid
  reminderId   String?          @map("reminder_id") @db.Uuid
  type         NotificationType
  message      String
  scheduledAt  DateTime         @map("scheduled_at") @db.Timestamptz(6)
  triggeredAt  DateTime?        @map("triggered_at") @db.Timestamptz(6)
  readAt       DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment  Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reminder     Reminder?        @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([reminderId])
  @@map("notifications")
}

model AuthAttempt {
  id          String            @id @default(uuid()) @db.Uuid
  email       String            @db.VarChar(255)
  userId      String?           @map("user_id") @db.Uuid
  result      AuthAttemptResult
  reason      String?           @db.VarChar(64)
  ip          String?           @db.VarChar(45)
  userAgent   String?           @map("user_agent")
  attemptedAt DateTime          @default(now()) @map("attempted_at") @db.Timestamptz(6)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([attemptedAt(sort: Desc)])
  @@index([email, attemptedAt(sort: Desc)])
  @@index([userId, attemptedAt(sort: Desc)])
  @@map("auth_attempts")
}

model UserMonthlyStat {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  totalCount     Int      @map("total_count")
  completedCount Int      @map("completed_count")
  completionRate Decimal  @map("completion_rate") @db.Decimal(5, 4)
  topSlot        String?  @map("top_slot") @db.VarChar(32)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month(sort: Desc)])
  @@map("user_monthly_stats")
}
