generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthAttemptResult {
  SUCCESS
  FAILURE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum RecurrenceType {
  ONETIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AppointmentSourceKind {
  USER
  SYSTEM
}

enum ReminderState {
  PENDING
  TRIGGERED
  SNOOZED
  CANCELLED
}

enum ReminderEventType {
  TRIGGERED
  SNOOZED
  CANCELLED
}

enum NotificationType {
  REMINDER
  TEAM_INVITATION
  TEAM_ACTIVITY
  SYSTEM
}

enum NotificationEventType {
  REMINDER_TRIGGERED
  TEAM_INVITE_CREATED
  TEAM_APPOINTMENT_CREATED
  TEAM_APPOINTMENT_UPDATED
  TEAM_APPOINTMENT_CANCELLED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
  DECLINED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ParticipationType {
  REQUIRED
  OPTIONAL
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  email                  String              @unique @db.VarChar(255)
  passwordHash           String              @map("password_hash") @db.VarChar(255)
  passwordResetTokenHash String?             @map("password_reset_token_hash") @db.VarChar(255)
  passwordResetExpiresAt DateTime?           @map("password_reset_expires_at") @db.Timestamptz(6)
  isVerified             Boolean             @default(false) @map("is_verified")
  displayName            String?             @map("display_name") @db.VarChar(100)
  timezone               String              @default("UTC") @db.VarChar(64)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)
  series                 AppointmentSeries[]
  appointments           Appointment[]
  tags                   Tag[]
  // reminders              Reminder[]
  notifications          Notification[]      @relation("NotificationRecipient")
  actedNotifications     Notification[]      @relation("NotificationActor")
  authAttempts           AuthAttempt[]
  monthlyStats           UserMonthlyStat[]
  userDevices            UserDevice[]
  teamsOwned             Team[]              @relation("TeamOwner")
  teamMemberships        TeamMember[]
  organizedTeamAppointments TeamAppointment[] @relation("TeamAppointmentOrganizer")
  appointmentParticipants AppointmentParticipant[]
  invitationsReceived    TeamInvitation[]    @relation("TeamInvitationInvitedUser")
  invitationsSent        TeamInvitation[]    @relation("TeamInvitationInvitedBy")

  @@map("users")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  ownerId     String           @map("owner_id") @db.Uuid
  name        String           @db.VarChar(120)
  description String?
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     TeamMember[]
  invitations TeamInvitation[]
  appointments TeamAppointment[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  teamId    String           @map("team_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TeamRole         @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  teamId        String           @map("team_id") @db.Uuid
  invitedUserId String           @map("invited_user_id") @db.Uuid
  invitedById   String           @map("invited_by_id") @db.Uuid
  role          TeamRole         @default(MEMBER)
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt   DateTime?        @map("responded_at") @db.Timestamptz(6)
  expiresAt     DateTime?        @map("expires_at") @db.Timestamptz(6)

  team       Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User @relation("TeamInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([teamId, invitedUserId, status])
  @@index([teamId])
  @@index([invitedUserId])
  @@map("team_invitations")
}

model TeamAppointment {
  id          String            @id @default(uuid()) @db.Uuid
  teamId      String            @map("team_id") @db.Uuid
  organizerId String            @map("organizer_id") @db.Uuid
  title       String            @db.VarChar(255)
  description String?
  location    String?           @db.VarChar(255)
  startAt     DateTime          @map("starts_at") @db.Timestamptz(6)
  endAt       DateTime          @map("ends_at") @db.Timestamptz(6)
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  team         Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizer    User                     @relation("TeamAppointmentOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  participants AppointmentParticipant[]
  notifications Notification[]

  @@map("team_appointments")
}

model AppointmentParticipant {
  teamAppointmentId String   @map("team_appointment_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  participationType ParticipationType @map("participation_type")

  teamAppointment TeamAppointment @relation(fields: [teamAppointmentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamAppointmentId, userId])
  @@map("appointment_participants")
}

model UserDevice {
  id           String   @id @default(uuid())
  userId       String   @map("user_id") @db.Uuid
  fcmToken     String   @unique @map("fcm_token")
  deviceName   String?  @map("device_name")
  platform     String?
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

// ================= SERIES =================
model AppointmentSeries {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title       String   @db.VarChar(255)
  description String?
  startAt     DateTime @map("start_at") @db.Timestamptz(6)
  endAt       DateTime @map("end_at") @db.Timestamptz(6)

  recurrenceType RecurrenceType @map("recurrence_type")

  // WEEKLY
  weeklyDay   Weekday[] @map("weekly_day")
  // MONTHLY
  monthlyDay  Int?      @map("month_day")
  // YEARLY
  yearlyDay   Int?      @map("yearly_day")
  yearlyMonth Int?      @map("yearly_month")

  offsetMinutes  Int?      @map("offset_minutes")
  seriesTimezone String    @map("series_timezone") @db.VarChar(64)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  tags         SeriesTag[]

  @@index([userId])
  @@map("appointment_series")
}

// ================= APPOINTMENT =================
model Appointment {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  seriesId String   @map("series_id") @db.Uuid
  startAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endAt    DateTime @map("ends_at") @db.Timestamptz(6)

  isRecurringInstance Boolean           @default(false) @map("is_recurring_instance")
  status              AppointmentStatus
  jobId               String?           @map("job_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  series        AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  // reminders     Reminder[]
  notifications Notification[]

  @@index([userId, startAt])
  @@index([seriesId])
  @@map("appointments")
}

// ================= TAG =================
model Tag {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  name   String  @db.VarChar(50)
  color  String? @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  series SeriesTag[]

  @@index([userId])
  @@map("tags")
}

// ================= SERIES TAG (NEW) =================
model SeriesTag {
  seriesId   String   @map("series_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  series AppointmentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  tag    Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([seriesId, tagId])
  @@index([tagId])
  @@map("series_tag")
}

