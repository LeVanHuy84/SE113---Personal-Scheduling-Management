generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthAttemptResult {
  SUCCESS
  FAILURE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum RecurrenceType {
  ONETIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AppointmentSourceKind {
  USER
  SYSTEM
}

enum ReminderState {
  PENDING
  TRIGGERED
  SNOOZED
  CANCELLED
}

enum ReminderEventType {
  TRIGGERED
  SNOOZED
  CANCELLED
}

enum NotificationType {
  REMINDER
  SYSTEM
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  email                  String              @unique @db.VarChar(255)
  passwordHash           String              @map("password_hash") @db.VarChar(255)
  passwordResetTokenHash String?             @map("password_reset_token_hash") @db.VarChar(255)
  passwordResetExpiresAt DateTime?           @map("password_reset_expires_at") @db.Timestamptz(6)
  isVerified             Boolean             @default(false) @map("is_verified")
  displayName            String?             @map("display_name") @db.VarChar(100)
  timezone               String              @default("UTC") @db.VarChar(64)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)
  series                 AppointmentSeries[]
  appointments           Appointment[]
  tags                   Tag[]
  reminders              Reminder[]
  notifications          Notification[]
  authAttempts           AuthAttempt[]
  monthlyStats           UserMonthlyStat[]

  @@map("users")
}

// ================= SERIES =================
model AppointmentSeries {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title       String   @db.VarChar(255)
  description String?
  startAt     DateTime @map("start_at") @db.Timestamptz(6)
  endAt       DateTime @map("end_at") @db.Timestamptz(6)

  recurrenceType RecurrenceType @map("recurrence_type")
  // recurrenceInterval   Int                 @default(1) @map("recurrence_interval")
  // recurrenceByDay      Weekday[]           @map("recurrence_by_day")
  // recurrenceDayOfMonth Int?                @map("recurrence_day_of_month") @db.SmallInt
  // recurrenceCount      Int?                @map("recurrence_count")

  // WEEKLY
  weeklyDay   Weekday[] @map("weekly_day")
  // MONTHLY
  monthlyDay  Int?      @map("month_day")
  // YEARLY
  yearlyDay   Int?      @map("yearly_day")
  yearlyMonth Int?      @map("yearly_month")

  offsetMinutes  Int?      @map("offset_minutes")
  seriesTimezone String    @map("series_timezone") @db.VarChar(64)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  tags         SeriesTag[]

  @@index([userId])
  @@map("appointment_series")
}

// ================= APPOINTMENT =================
model Appointment {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  seriesId String   @map("series_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  isRecurringInstance Boolean           @default(false) @map("is_recurring_instance")
  status              AppointmentStatus

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  series        AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  reminders     Reminder[]
  notifications Notification[]

  @@index([userId, startsAt])
  @@index([seriesId])
  @@map("appointments")
}

// ================= TAG =================
model Tag {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  name   String  @db.VarChar(50)
  color  String? @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  series SeriesTag[]

  @@index([userId])
  @@map("tags")
}

// ================= SERIES TAG (NEW) =================
model SeriesTag {
  seriesId   String   @map("series_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  series AppointmentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  tag    Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([seriesId, tagId])
  @@index([tagId])
  @@map("series_tag")
}

// ================= REMINDER (NEW DESIGN) =================
model Reminder {
  id            String @id @default(uuid()) @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid
  jobId         String @unique @map("job_id")

  occurrenceTime DateTime @map("occurrence_time") @db.Timestamptz(6)
  nextTriggerAt  DateTime @map("next_trigger_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, nextTriggerAt])
  @@map("reminders")
}

// ================= NOTIFICATION =================
model Notification {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  reminderId    String? @map("reminder_id") @db.Uuid

  type    NotificationType
  message String

  triggeredAt DateTime? @map("triggered_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reminder    Reminder?    @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuthAttempt {
  id          String            @id @default(uuid()) @db.Uuid
  email       String            @db.VarChar(255)
  userId      String?           @map("user_id") @db.Uuid
  result      AuthAttemptResult
  reason      String?           @db.VarChar(64)
  ip          String?           @db.VarChar(45)
  userAgent   String?           @map("user_agent")
  attemptedAt DateTime          @default(now()) @map("attempted_at") @db.Timestamptz(6)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([attemptedAt(sort: Desc)])
  @@index([email, attemptedAt(sort: Desc)])
  @@index([userId, attemptedAt(sort: Desc)])
  @@map("auth_attempts")
}

model UserMonthlyStat {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  totalCount     Int      @map("total_count")
  completedCount Int      @map("completed_count")
  completionRate Decimal  @map("completion_rate") @db.Decimal(5, 4)
  topSlot        String?  @map("top_slot") @db.VarChar(32)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month(sort: Desc)])
  @@map("user_monthly_stats")
}
