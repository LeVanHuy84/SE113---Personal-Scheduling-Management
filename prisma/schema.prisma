// ================= NOTIFICATION =================
model Notification {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  actorUserId       String?              @map("actor_user_id") @db.Uuid
  appointmentId     String?              @map("appointment_id") @db.Uuid
  teamInvitationId  String?              @map("team_invitation_id") @db.Uuid
  teamAppointmentId String?              @map("team_appointment_id") @db.Uuid

  type       NotificationType
  eventType  NotificationEventType? @map("event_type")
  title      String?               @db.VarChar(255)
  message    String
  payload    Json?

  readAt     DateTime?             @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor           User?             @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  teamInvitation  TeamInvitation?    @relation(fields: [teamInvitationId], references: [id], onDelete: SetNull)
  teamAppointment TeamAppointment?   @relation(fields: [teamAppointmentId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([teamInvitationId])
  @@index([teamAppointmentId])
  @@map("notifications")
}

model AuthAttempt {
  id          String            @id @default(uuid()) @db.Uuid
  email       String            @db.VarChar(255)
  userId      String?           @map("user_id") @db.Uuid
  result      AuthAttemptResult
  reason      String?           @db.VarChar(64)
  ip          String?           @db.VarChar(45)
  userAgent   String?           @map("user_agent")
  attemptedAt DateTime          @default(now()) @map("attempted_at") @db.Timestamptz(6)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([attemptedAt(sort: Desc)])
  @@index([email, attemptedAt(sort: Desc)])
  @@index([userId, attemptedAt(sort: Desc)])
  @@map("auth_attempts")
}

model UserMonthlyStat {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  month          DateTime @db.Date
  totalCount     Int      @map("total_count")
  completedCount Int      @map("completed_count")
  completionRate Decimal  @map("completion_rate") @db.Decimal(5, 4)
  topSlot        String?  @map("top_slot") @db.VarChar(32)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month(sort: Desc)])
  @@map("user_monthly_stats")
}
